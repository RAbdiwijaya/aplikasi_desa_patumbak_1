APP_NAME="Desa Patumbak 1"
APP_ENV=production
APP_KEY=base64:V1B9qwBVYhhorWvBeundFempiXwrMxCdAhVbGNOiDac=
APP_DEBUG=false
APP_URL=https://your-app-name.railway.app

# Localization
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Maintenance
APP_MAINTENANCE_DRIVER=file

# PHP
PHP_CLI_SERVER_WORKERS=4

# Security
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database (Railway will inject these)
DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

# Filesystem
FILESYSTEM_DISK=local

# Queue
QUEUE_CONNECTION=database

# Cache
CACHE_STORE=database

# Mail (set to log for now, configure later)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@desapatumbak1.com"
MAIL_FROM_NAME="${APP_NAME}"

# Remove unused services or comment them out
# REDIS_HOST=127.0.0.1
# AWS_ACCESS_KEY_ID=
# MEMCACHED_HOST=127.0.0.1

# Vite (for frontend)
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
